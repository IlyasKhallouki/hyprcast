// hyprcast waybar module -- paste unedited.
//
//   1. add "custom/hyprcast" to modules-left / modules-center / modules-right
//   2. paste the block below at the top level of ~/.config/waybar/config.jsonc
//   3. paste the CSS at the bottom of ~/.config/waybar/style.css
//
// The module STREAMS: no "interval", no "signal". `hyprcast waybar` writes one
// JSON object per line and flushes every one, so the bar changes the instant
// the session does and the tooltip's timer counts once a second. Adding an
// "interval" would restart the process every N seconds and break both.
//
// States, which arrive as "alt" and as a CSS class: idle, discovering,
// connecting, casting, error -- plus "muted" and "degraded" alongside
// "casting" when they apply.

  "custom/hyprcast": {
    "exec": "hyprcast waybar",
    "return-type": "json",
    "restart-interval": 5,
    "tooltip": true,
    "format": "{icon} {}",

    // Font Awesome 4 codepoints. They exist in every Nerd Font, v2 and v3, and
    // unlike the Material Design set they have never been renumbered. Change
    // them here; nothing in hyprcast hard-codes a glyph.
    "format-icons": {
      "idle":        "\uf108",
      "discovering": "\uf002",
      "connecting":  "\uf021",
      "casting":     "\uf1eb",
      "error":       "\uf071"
    },

    // Clicks are separate shell commands with no way to read state first, so
    // every one of these is self-contained: the control socket resolves what
    // "the other mode" and "5 points louder" currently mean.
    "on-click":        "hyprcast ctl toggle-mode",
    "on-click-right":  "hyprcast ctl toggle-mute",
    "on-click-middle": "hyprcast ctl stop",
    "on-scroll-up":    "hyprcast ctl volume-up",
    "on-scroll-down":  "hyprcast ctl volume-down"
  },

// on-click     mirror <-> extend, live: the headless output is created, capture
//              moves onto it, and only then is the old one removed. The sink
//              never renegotiates -- the wire size was frozen at M3.
// on-click-middle  ends the whole session, not just the encoder: the P2P group
//              and the GO intent come back down too.
// scroll       volume-up / volume-down take an optional step:
//              "hyprcast ctl volume-up 10". The default is 5, clamped to 0..100.
//
// Nothing here starts a cast, because `hyprcast cast` runs in the foreground
// and would become a child of waybar. Bind that to a key, or use the unit:
//   systemctl --user start hyprcast

/* style.css -- the classes above, with Catppuccin Mocha colours

#custom-hyprcast                { padding: 0 10px; }
#custom-hyprcast.idle           { opacity: 0.5; }
#custom-hyprcast.discovering,
#custom-hyprcast.connecting     { color: #f9e2af; }
#custom-hyprcast.casting        { color: #a6e3a1; }
#custom-hyprcast.casting.muted  { color: #94e2d5; }
#custom-hyprcast.degraded       { color: #fab387; }
#custom-hyprcast.error          { color: #f38ba8; background: rgba(243, 139, 168, 0.12); }

*/
